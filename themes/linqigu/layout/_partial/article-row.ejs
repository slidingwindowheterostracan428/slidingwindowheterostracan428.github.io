<% const thumbMap = { '项目': 'thumb-tool', '阅读': 'thumb-book', '随笔': 'thumb-walk' }; %>
<% posts.forEach(function(post) { %>
  <% const category = post.categories && post.categories.length ? post.categories.first().name : '随笔'; %>
  <% const summary = (post.excerpt || post.content || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim(); %>
  <article class="article-row" data-category="<%= category %>" data-title="<%= post.title %> <%= summary %>">
    <div class="article-thumb <%= thumbMap[category] || 'thumb-tool' %>"><span><%= category.toUpperCase() %><br />NOTE</span></div>
    <div class="article-body">
      <div class="article-meta"><span class="tag"><%= category %></span><span><%= date(post.date, 'YYYY.MM.DD') %></span></div>
      <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
      <p><%= summary %></p>
    </div>
    <a class="row-arrow" href="<%- url_for(post.path) %>" aria-label="阅读文章">↗</a>
  </article>
<% }); %>
